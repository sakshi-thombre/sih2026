# CORS: comma-separated origins the frontend is served from (see
# app/core/config.py::cors_allow_origins, app/main.py). Defaults cover
# the standard Next.js/CRA and Vite local dev ports. Never set this to
# "*" — the frontend sends credentials (the Supabase JWT), and browsers
# reject a wildcard origin combined with credentialed requests.
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase project the backend talks to via PostgREST (see app/db/session.py).
# Local dev values match `supabase start` output when supabase/config.toml is used.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Bypasses Row Level Security. Only used for POST /api/v1/agent/tools/execute
# (see app/db/session.py::get_service_db) — never for user-facing requests.
SUPABASE_SERVICE_ROLE_KEY=

# Local Ollama instance (see app/llm/ollama.py, app/rag/embeddings.py).
# qwen3:8b is a "thinking" model with a slow cold start — the generous
# timeout below is intentional, see app/core/config.py.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text

# Local disk path for the Phase 3 prototype vector store (see
# app/rag/vector_store.py). Gitignored — not shared across instances.
VECTOR_STORE_PATH=./data/vector_store

# Document ingestion limits (see app/api/v1/endpoints/documents.py,
# app/rag/chunking.py).
MAX_UPLOAD_SIZE_BYTES=20971520
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Person C's agent service (see app/clients/agent_client.py). The URL
# below is a local-dev placeholder until Person C publishes the real
# address.
AGENT_SERVICE_BASE_URL=http://localhost:8100
AGENT_SERVICE_TIMEOUT_SECONDS=30

# Service-to-service auth for endpoints Person C's agent service calls
# (currently POST /api/v1/agent/tools/execute) — see
# app/api/deps.py::verify_internal_service. Left unset by default so
# local dev/testing needs no extra setup; when set, callers must send a
# matching X-Internal-Service-Token header.
INTERNAL_SERVICE_TOKEN=
